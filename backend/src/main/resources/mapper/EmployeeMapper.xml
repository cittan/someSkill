<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.roster.mapper.EmployeeMapper">

    <!-- 列表查询公共片段：deptId 由服务端按角色收窄后传入，keyword 为姓名/工号模糊 -->
    <sql id="condition">
        <where>
            <if test="deptId != null">
                AND dept_id = #{deptId}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE concat('%', #{keyword}, '%')
                  OR emp_no LIKE concat('%', #{keyword}, '%'))
            </if>
        </where>
    </sql>

    <select id="selectByCondition" resultType="Employee">
        SELECT * FROM employee
        <include refid="condition"/>
        ORDER BY emp_no
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*) FROM employee
        <include refid="condition"/>
    </select>

    <select id="selectById" resultType="Employee">
        SELECT * FROM employee WHERE id = #{id}
    </select>

    <select id="selectAll" resultType="Employee">
        SELECT * FROM employee ORDER BY emp_no
    </select>

    <!-- 导入幂等预查：一次 IN 查询取回库内已存在的工号（调用前需保证集合非空） -->
    <select id="selectByEmpNoIn" resultType="Employee">
        SELECT * FROM employee
        WHERE emp_no IN
        <foreach collection="empNos" item="no" open="(" separator="," close=")">
            #{no}
        </foreach>
    </select>

    <!-- 批量插入：foreach 拼多值 INSERT，一条 SQL 写入一整批（500 条） -->
    <insert id="insertBatch">
        INSERT INTO employee
            (emp_no, name, dept_id, position, email, phone,
             id_card, bank_card, salary, attendance_no, status, hire_date)
        VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.empNo}, #{e.name}, #{e.deptId}, #{e.position}, #{e.email}, #{e.phone},
             #{e.idCard}, #{e.bankCard}, #{e.salary}, #{e.attendanceNo}, #{e.status}, #{e.hireDate})
        </foreach>
    </insert>
</mapper>
